{
  "expo": {
    "name": "Chromaze",
    "slug": "chromaze",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chromaze.game"
    },
    "android": {
      "package": "com.chromaze.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/chromaze_adaptive_foreground.png",
        "backgroundColor": "#111827"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827"
        }
      ]
    ],
    "icon": "./assets/brand/chromaze_app_icon.png"
  }
}
